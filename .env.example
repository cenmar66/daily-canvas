# Supabase → Project Settings → API Keys (same project Write.ai uses is fine)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The only email allowed to sign in
ALLOWED_EMAIL=cenmarf@gmail.com

# Any long random string (40+ characters). Encrypts Google tokens. Never change it after connecting Google.
ENCRYPTION_KEY=

# Optional: Google Calendar + Google Tasks (docs/INTEGRATIONS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: cloud dictation fallback for browsers without built-in speech recognition
DEEPGRAM_API_KEY=

# Local development/tests only: run without signing in, data kept in the browser.
# Ignored in production builds. Never set this in Vercel.
# NEXT_PUBLIC_CANVAS_LOCAL_ONLY=1
